# Gemini (leitor_gemini.py)
GEMINI_API_KEY=

# Google Custom Search / Imagens (opcional)
GOOGLE_CSE_KEY=
GOOGLE_CSE_CX=

# Groq (leitor_groq.py) - chave gratuita em https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_API_URL=https://api.groq.com/openai/v1/chat/completions

# SI5 Global (opcional)
SI5_API_TOKEN=
SI5_API_URL=https://api.si5.com.br/v1/produtos

# API Cloud
# Use chaves separadas por cliente para auditoria e rate limit independentes.
# Gere cada valor com: openssl rand -hex 32
API_KEY_ESP32=gere-uma-chave-forte-para-esp32
API_KEY_DASHBOARD=gere-uma-chave-forte-para-dashboard
# API_KEY permanece como fallback legado (usado quando as específicas não
# estão definidas). Remova ou deixe em branco quando migrar para as chaves acima.
API_KEY=gere-uma-chave-forte-aqui
API_URL=https://sua-api.railway.app/upload
MAX_UPLOAD_MB=5

# WiFi (referência para firmware/secrets.h)
WIFI_SSID=seu-ssid
WIFI_PASS=sua-senha
